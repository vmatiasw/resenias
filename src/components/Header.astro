---
import { siteConfig } from '../config/site';
---

<header class="border-b border-stone-200 bg-white">
  <div class="mx-auto max-w-5xl px-4 py-4">
    <a href="/" class="block text-xl font-bold text-stone-900">{siteConfig.name}</a>
    <nav aria-label="Principal" class="mt-3 overflow-x-auto">
      <ul class="flex min-w-max gap-4 text-sm font-medium text-stone-700">
        {siteConfig.navigation.map((item) => (
          <li><a class="hover:text-stone-900" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
