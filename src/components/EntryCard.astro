---
interface Props {
  title: string;
  summary: string;
  href: string;
  category: string;
  tags: string[];
}

const { title, summary, href, category, tags } = Astro.props;
---

<article class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm">
  <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">{category}</p>
  <h3 class="mt-1 text-lg font-semibold"><a class="hover:underline" href={href}>{title}</a></h3>
  <p class="mt-2 text-sm text-stone-700">{summary}</p>
  <ul class="mt-3 flex flex-wrap gap-2 text-xs text-stone-600">
    {tags.map((tag) => <li class="rounded bg-stone-100 px-2 py-1">#{tag}</li>)}
  </ul>
</article>
