---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reseñas = await getCollection('resenias');
  return reseñas.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} image={entry.data.images[0]?.src}>
  <article>
    <header>
      <p class="text-sm text-stone-600">Producto: {entry.data.product}</p>
      <h1 class="mt-2 text-3xl font-bold">{entry.data.title}</h1>
      <p class="mt-3 text-stone-700">{entry.data.summary}</p>
    </header>

    {entry.data.images[0] && (
      <img class="mt-6 rounded-lg border border-stone-200" src={entry.data.images[0].src} alt={entry.data.images[0].alt} loading="lazy" />
    )}

    <div class="prose mt-6 max-w-none prose-stone">
      <Content />
    </div>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">Etiquetas</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {entry.data.tags.map((tag: string) => <li class="rounded bg-stone-100 px-3 py-1 text-sm">#{tag}</li>)}
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">Contenido relacionado</h2>
      <ul class="mt-3 list-disc pl-5 text-stone-700">
        {entry.data.links.map((link: { label: string; url: string }) => (
          <li><a class="underline" href={link.url}>{link.label}</a></li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>
