---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout title="Contacto" description="Email de contacto para consultas directas.">
  <h1 class="text-3xl font-bold">Contacto</h1>
  <p class="mt-4 text-stone-700">Podés escribirme directamente por email.</p>
  <p class="mt-3 rounded border border-stone-200 bg-white p-4 text-stone-900">
    <strong>Email:</strong> {siteConfig.contactEmail}
    <br />
    <a class="underline" href={`mailto:${siteConfig.contactEmail}`}>Enviar email</a>
  </p>
</BaseLayout>
