---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout title="Contacto" description="Formulario de contacto para consultas directas.">
  <h1 class="text-3xl font-bold">Contacto</h1>
  <form class="mt-6 space-y-3 rounded border border-stone-200 bg-white p-4" method="POST" action={siteConfig.forms.contact}>
    <label class="block text-sm">Nombre
      <input required class="mt-1 w-full rounded border border-stone-300 px-3 py-2" type="text" name="nombre" />
    </label>
    <label class="block text-sm">Email
      <input required class="mt-1 w-full rounded border border-stone-300 px-3 py-2" type="email" name="email" />
    </label>
    <label class="block text-sm">Mensaje
      <textarea required class="mt-1 w-full rounded border border-stone-300 px-3 py-2" name="mensaje" rows="5"></textarea>
    </label>
    <button class="rounded bg-stone-900 px-4 py-2 text-sm font-medium text-white" type="submit">Enviar</button>
  </form>
</BaseLayout>
