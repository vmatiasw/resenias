---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout title="Cómo aportar" description="Compartí sugerencias o productos para próximas reseñas.">
  <h1 class="text-3xl font-bold">Cómo aportar</h1>
  <p class="mt-3 text-stone-700">Podés sugerir productos, corregir datos o proponer nuevas comparativas.</p>

  <form class="mt-6 space-y-3 rounded border border-stone-200 bg-white p-4" method="POST" action={siteConfig.forms.contribute}>
    <label class="block text-sm">Nombre
      <input required class="mt-1 w-full rounded border border-stone-300 px-3 py-2" type="text" name="nombre" />
    </label>
    <label class="block text-sm">Email
      <input required class="mt-1 w-full rounded border border-stone-300 px-3 py-2" type="email" name="email" />
    </label>
    <label class="block text-sm">Tu aporte
      <textarea required class="mt-1 w-full rounded border border-stone-300 px-3 py-2" name="aporte" rows="5"></textarea>
    </label>
    <button class="rounded bg-stone-900 px-4 py-2 text-sm font-medium text-white" type="submit">Enviar aporte</button>
  </form>
</BaseLayout>
