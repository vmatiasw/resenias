---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../utils/slugify';

const resenias = (await getCollection('resenias')).slice(0, 3);
const publicaciones = (await getCollection('publicaciones')).slice(0, 3);
const categories = Array.from(new Set([
  ...resenias.map((item) => item.data.category),
  ...publicaciones.map((item) => item.data.category)
]));
---

<BaseLayout title="Inicio" description="Reseñas y recomendaciones simples para decidir mejor qué comprar.">
  <section aria-labelledby="presentacion">
    <h1 id="presentacion" class="text-3xl font-bold tracking-tight">Reseñas y recomendaciones claras</h1>
    <p class="mt-3 max-w-2xl text-stone-700">
      Un catálogo personal con reseñas honestas y recomendaciones prácticas, pensado para leer cómodo en celular.
    </p>
    <a class="mt-4 inline-block rounded bg-stone-900 px-4 py-2 text-sm font-medium text-white" href="/buscar">Buscar por etiqueta o categoría</a>
  </section>

  <section class="mt-10" aria-labelledby="resenas-recientes">
    <h2 id="resenas-recientes" class="text-2xl font-semibold">Reseñas recientes</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {resenias.map((entry) => (
        <EntryCard
          title={entry.data.title}
          summary={entry.data.summary}
          href={`/resenias/${entry.data.slug}`}
          category={entry.data.category}
          tags={entry.data.tags}
        />
      ))}
    </div>
  </section>

  <section class="mt-10" aria-labelledby="publicaciones-recientes">
    <h2 id="publicaciones-recientes" class="text-2xl font-semibold">Publicaciones recientes</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {publicaciones.map((entry) => (
        <EntryCard
          title={entry.data.title}
          summary={entry.data.summary}
          href={`/publicaciones/${entry.data.slug}`}
          category={entry.data.category}
          tags={entry.data.tags}
        />
      ))}
    </div>
  </section>

  <section class="mt-10" aria-labelledby="categorias">
    <h2 id="categorias" class="text-2xl font-semibold">Categorías</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {categories.map((category) => (
        <li>
          <a class="rounded bg-stone-200 px-3 py-2 text-sm hover:bg-stone-300" href={`/categorias/${slugify(category)}`}>
            {category}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
