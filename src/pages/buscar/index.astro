---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const reseñas = await getCollection('resenias');
const publicaciones = await getCollection('publicaciones');

const items = [
  ...reseñas.map((item) => ({
    title: item.data.title,
    href: `/resenias/${item.data.slug}`,
    category: item.data.category,
    tags: item.data.tags,
    type: 'Reseña'
  })),
  ...publicaciones.map((item) => ({
    title: item.data.title,
    href: `/publicaciones/${item.data.slug}`,
    category: item.data.category,
    tags: item.data.tags,
    type: 'Publicación'
  }))
];
---

<BaseLayout title="Buscar" description="Buscar por texto, categoría o etiqueta.">
  <h1 class="text-3xl font-bold">Buscar contenido</h1>
  <label class="mt-4 block text-sm font-medium" for="search">Texto</label>
  <input id="search" type="search" class="mt-1 w-full rounded border border-stone-300 bg-white px-3 py-2" placeholder="Ej: café" />

  <ul id="results" class="mt-6 space-y-3"></ul>

  <script type="application/json" id="search-data" set:html={JSON.stringify(items)}></script>
  <script>
    const dataNode = document.getElementById('search-data');
    const input = document.getElementById('search');
    const results = document.getElementById('results');
    type SearchItem = { title: string; href: string; category: string; tags: string[]; type: string };
    const items: SearchItem[] = JSON.parse(dataNode?.textContent ?? '[]') as SearchItem[];

    if (!(input instanceof HTMLInputElement) || !(results instanceof HTMLUListElement)) {
      throw new Error('Elementos de búsqueda no disponibles.');
    }

    const render = (query = '') => {
      const normalized = query.toLowerCase().trim();
      const filtered = !normalized
        ? items
        : items.filter((item) => {
            const haystack = [item.title, item.category, ...(item.tags ?? [])].join(' ').toLowerCase();
            return haystack.includes(normalized);
          });

      results.innerHTML = filtered
        .map(
          (item) => `
            <li class="rounded border border-stone-200 bg-white p-3">
              <p class="text-xs text-stone-500">${item.type} · ${item.category}</p>
              <a class="font-medium underline" href="${item.href}">${item.title}</a>
              <p class="mt-1 text-xs text-stone-600">#${item.tags.join(' #')}</p>
            </li>
          `
        )
        .join('');
    };

    input.addEventListener('input', () => render(input.value));
    render();
  </script>
</BaseLayout>
