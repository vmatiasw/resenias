---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugify';

const resenias = await getCollection('resenias');
const publicaciones = await getCollection('publicaciones');

const allCategories = Array.from(new Set([
  ...resenias.map((item) => item.data.category),
  ...publicaciones.map((item) => item.data.category)
]));

export async function getStaticPaths() {
  const resenias = await getCollection('resenias');
  const publicaciones = await getCollection('publicaciones');

  const categories = Array.from(new Set([
    ...resenias.map((item) => item.data.category),
    ...publicaciones.map((item) => item.data.category)
  ]));

  return categories.map((category) => ({
    params: { categoria: slugify(category) },
    props: { category }
  }));
}

const { category } = Astro.props;
const categoryEntries = [
  ...resenias.filter((item) => item.data.category === category).map((item) => ({
    title: item.data.title,
    summary: item.data.summary,
    href: `/resenias/${item.data.slug}`,
    category: item.data.category,
    tags: item.data.tags
  })),
  ...publicaciones.filter((item) => item.data.category === category).map((item) => ({
    title: item.data.title,
    summary: item.data.summary,
    href: `/publicaciones/${item.data.slug}`,
    category: item.data.category,
    tags: item.data.tags
  }))
];
---

<BaseLayout title={`Categoría: ${category}`} description={`Listado de contenido en ${category}.`}>
  <h1 class="text-3xl font-bold">Categoría: {category}</h1>
  {categoryEntries.length ? (
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {categoryEntries.map((entry) => <EntryCard {...entry} />)}
    </div>
  ) : (
    <p class="mt-6 text-stone-700">No hay publicaciones en esta categoría.</p>
  )}

  <h2 class="mt-10 text-xl font-semibold">Todas las categorías</h2>
  <ul class="mt-3 flex flex-wrap gap-2">
    {allCategories.map((item) => (
      <li><a class="rounded bg-stone-100 px-3 py-1 text-sm" href={`/categorias/${slugify(item)}`}>{item}</a></li>
    ))}
  </ul>
</BaseLayout>
