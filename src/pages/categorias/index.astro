---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugify';

const resenias = await getCollection('resenias');
const publicaciones = await getCollection('publicaciones');
const categories = Array.from(new Set([
  ...resenias.map((item) => item.data.category),
  ...publicaciones.map((item) => item.data.category)
]));
---

<BaseLayout title="Categorías" description="Explorá el contenido por categorías.">
  <h1 class="text-3xl font-bold">Categorías</h1>
  <ul class="mt-6 grid gap-3 sm:grid-cols-2">
    {categories.map((category) => (
      <li>
        <a class="block rounded border border-stone-200 bg-white p-4 hover:border-stone-300" href={`/categorias/${slugify(category)}`}>
          {category}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
